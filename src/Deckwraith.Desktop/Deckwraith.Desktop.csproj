<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Deckwraith.Desktop</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ElectronNET.API" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Deckwraith.Application/Deckwraith.Application.csproj" />
    <ProjectReference Include="../Deckwraith.Hosting/Deckwraith.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="electron.manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets/deckwraith-icon.icns" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets/deckwraith-icon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets/deckwraith-icon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildRenderer" BeforeTargets="ComputeFilesToPublish" Condition="'$(SkipRendererBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../../ui" Command="npm ci" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../../ui" Command="npm run build" />
    <ItemGroup>
      <RendererAsset Include="$(MSBuildProjectDirectory)/../../ui/dist/**/*" />
      <ResolvedFileToPublish Include="@(RendererAsset)">
        <RelativePath>wwwroot/%(RendererAsset.RecursiveDir)%(RendererAsset.Filename)%(RendererAsset.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
