{
  "executable": "Deckwraith.Desktop",
  "environment": "Production",
  "singleInstance": true,
  "build": {
    "appId": "local.deckwraith.app",
    "productName": "Deckwraith",
    "copyright": "Copyright 2026 Deckwraith contributors",
    "buildVersion": "1.0.0",
    "compression": "maximum",
    "directories": {
      "output": "../../artifacts/desktop",
      "buildResources": "bin/Assets"
    },
    "extraResources": [
      {
        "from": "./bin",
        "to": "bin",
        "filter": ["**/*"]
      }
    ],
    "files": [
      {
        "from": "./ElectronHostHook/node_modules",
        "to": "ElectronHostHook/node_modules",
        "filter": ["**/*"]
      },
      "**/*"
    ],
    "mac": {
      "icon": "bin/Assets/deckwraith-icon.icns",
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"]
    },
    "linux": {
      "icon": "bin/Assets/deckwraith-icon.png",
      "category": "Development",
      "target": ["AppImage", "tar.gz"]
    },
    "win": {
      "icon": "bin/Assets/deckwraith-icon.ico",
      "target": ["nsis", "zip"]
    }
  }
}
